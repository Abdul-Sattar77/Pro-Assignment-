includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes

    # Start pragmatic; raise over time (docs/conventions/backend-standards.md §9).
    level: 6

    # Parallel worker processes crash silently on some Windows/PHP CLI setups;
    # single-process analysis is reliable and fast enough for this codebase.
    parallel:
        maximumNumberOfProcesses: 1

    ignoreErrors: []
