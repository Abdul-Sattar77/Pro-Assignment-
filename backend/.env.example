APP_NAME=Prossignment
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend origin (Next.js) — used for CORS, Sanctum, and redirect links.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — single source of truth. Keep env-based so we can point at a
# VPS or managed Postgres (Neon, Supabase, AWS RDS) without code changes.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=prossignment_portal
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- WhatsApp Business Cloud API ----
# From Meta App dashboard -> WhatsApp -> API Setup. See
# docs/architecture/whatsapp-integration.md for the full setup runbook.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Permanent System User token (dashboard tokens expire after 24h).
WHATSAPP_ACCESS_TOKEN=
# Arbitrary secret you also enter in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# App secret -> validates the X-Hub-Signature-256 HMAC on inbound webhooks.
WHATSAPP_APP_SECRET=
# Only set to false locally when replaying captured payloads by hand.
WHATSAPP_VERIFY_SIGNATURE=true
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_SEND_READ_RECEIPTS=true
WHATSAPP_MEDIA_DISK=local
# Paid template used only when replying outside the 24h service window.
WHATSAPP_TEMPLATE_REOPEN=service_followup
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- Gmail / Google Workspace shared inbox ----
# Google disabled Basic Auth + App Passwords for Workspace IMAP in May 2025,
# so OAuth is required. See docs/architecture/email-integration.md.
# Mode: service_account (preferred, admin grants domain-wide delegation) or
#       refresh_token (mailbox owner consents once in a browser).
GMAIL_AUTH_MODE=service_account
GMAIL_MAILBOX=
GMAIL_FROM_NAME="${APP_NAME}"

# --- service_account mode ---
# Either point at the downloaded JSON key file...
GMAIL_CREDENTIALS_PATH=
# ...or paste the two fields inline (keep the \n escapes in the key).
GMAIL_CLIENT_EMAIL=
GMAIL_PRIVATE_KEY=

# --- refresh_token mode ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Sync tuning
GMAIL_SYNC_INTERVAL=1
GMAIL_SYNC_MAX=50
GMAIL_BACKFILL_DAYS=30
