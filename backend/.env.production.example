# ============================================================================
# Prossignment — BACKEND production environment template
# Copy to `.env` on the server and fill every <REPLACE> value.
# NEVER commit the filled file. Generate secrets; do not reuse dev values.
# ============================================================================

APP_NAME=Prossignment
APP_ENV=production
# Generate once on the server:  php artisan key:generate
APP_KEY=
# MUST be false in production — true leaks stack traces and env to users.
APP_DEBUG=false
# Public HTTPS origin of the API (no trailing slash).
APP_URL=https://api.your-domain.com

# Public HTTPS origin of the Next.js frontend — drives CORS + reset/redirect links.
FRONTEND_URL=https://app.your-domain.com
# Host:port pairs allowed as Sanctum stateful domains (frontend host).
SANCTUM_STATEFUL_DOMAINS=app.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Quieter logs in production; keep stack for daily rotation.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---- PostgreSQL (managed or self-hosted) ----
DB_CONNECTION=pgsql
DB_HOST=<REPLACE-db-host>
DB_PORT=5432
DB_DATABASE=prossignment_portal
DB_USERNAME=<REPLACE-db-user>
DB_PASSWORD=<REPLACE-strong-db-password>

# ---- Session / cache / queue ----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot shares the cookie across app + api subdomains.
SESSION_DOMAIN=.your-domain.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ---- Real-time (Laravel Reverb / Pusher protocol) ----
# Run `php artisan reverb:start` under a supervisor (see DEPLOYMENT.md).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=<REPLACE-random-id>
REVERB_APP_KEY=<REPLACE-random-key>
REVERB_APP_SECRET=<REPLACE-random-secret>
REVERB_HOST=ws.your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
# Where the Reverb process itself binds (behind nginx TLS termination).
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ---- Mail (transactional email — required for notifications) ----
# Replace the whole block with real SMTP; MAIL_MAILER=log only captures to file.
MAIL_MAILER=smtp
MAIL_HOST=<REPLACE-smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<REPLACE-smtp-user>
MAIL_PASSWORD=<REPLACE-smtp-password>
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Object storage (optional — switch FILESYSTEM_DISK=s3 to use) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---- WhatsApp Business Cloud API (separate scope — leave blank if unused) ----
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_SIGNATURE=true
WHATSAPP_MEDIA_DISK=local

# ---- Gmail / Google Workspace shared inbox (optional) ----
GMAIL_AUTH_MODE=service_account
GMAIL_MAILBOX=
GMAIL_FROM_NAME="${APP_NAME}"
GMAIL_CREDENTIALS_PATH=
GMAIL_CLIENT_EMAIL=
GMAIL_PRIVATE_KEY=
