# Normalize line endings across the team (Windows/macOS/Linux).
* text=auto eol=lf

# Shell scripts and husky hooks must be LF.
*.sh text eol=lf
.husky/* text eol=lf

# Treat these as binary (never normalize/diff).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
*.zip binary
