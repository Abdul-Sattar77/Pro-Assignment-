# ───────────────── Frontend production environment (Next.js) ─────────────────
# Copy to `.env.production` (or set in the host's env panel) before `npm run build`.
# Only NEXT_PUBLIC_* vars reach the browser — never put secrets here.

# Laravel API origin (HTTPS, no trailing slash).
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# This frontend's public origin.
NEXT_PUBLIC_APP_URL=https://app.your-domain.com

# Currency shown in finance/invoices (ISO 4217, e.g. GBP, USD, PKR).
NEXT_PUBLIC_APP_CURRENCY=GBP

# ---- Real-time (must match the backend REVERB_* values) ----
NEXT_PUBLIC_REVERB_APP_KEY=<same as backend REVERB_APP_KEY>
NEXT_PUBLIC_REVERB_HOST=ws.your-domain.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https
